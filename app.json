{
  "expo": {
    "name": "VKU Đặt Phòng",
    "slug": "vku-room-booking",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "vku-room-booking",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0F1E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "vn.vku.roombook"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0F1E"
      },
      "package": "vn.vku.roombook"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "shortName": "VKU Room",
      "name": "VKU Đặt Phòng Học & Lab",
      "description": "Ứng dụng đặt phòng học và phòng lab VKU",
      "display": "standalone",
      "backgroundColor": "#FFFFFF",
      "themeColor": "#1E6FD9"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1E6FD9"
        }
      ]
    ]
  }
}
